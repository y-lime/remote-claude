// remote-claude の EC2 上で動かす devcontainer のひな形。アプリのリポジトリに .devcontainer/ ごとコピーして使う
{
  "name": "remote-claude",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Java（Amazon Corretto）と Gradle。EC2 のホストには入れないので、バージョンはここで決める
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25", "jdkDistro": "amzn", "installGradle": true, "gradleVersion": "9.8.2"
    }
  },

  // EC2 の Bedrock と CodeArtifact の設定（/etc/remote-claude/claude.env）をそのまま渡す。
  // AWS の認証情報は IMDS からインスタンスロールのものを取る（ホップ数 2 にしてある）
  "runArgs": ["--env-file", "/etc/remote-claude/claude.env"],

  "mounts": [
    // Claude Code の設定と履歴は名前付きボリュームに置き、コンテナを作り直しても残す（プロジェクト間で共有）
    "source=remote-claude-config,target=/home/vscode/.claude,type=volume",
    // Gradle が CodeArtifact を見るようにする init スクリプト（EC2 の user data が置く）
    "source=/etc/remote-claude/gradle,target=/home/vscode/.gradle/init.d,type=bind,readonly",
    // 依存ライブラリのキャッシュ。コンテナを作り直しても取り直さない
    "source=remote-claude-gradle,target=/home/vscode/.gradle/caches,type=volume",
    // Claude Code が作業中かを EC2 に知らせる hook（managed settings）と、その書き込み先。
    // EC2 は、接続がなく Claude Code も作業していなければ自分で停止する（cdk.json の idleStopMinutes）
    "source=/etc/remote-claude/claude-code,target=/etc/claude-code,type=bind,readonly",
    "source=/run/remote-claude/claude-activity,target=/run/remote-claude/claude-activity,type=bind"
  ],
  "containerEnv": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" },
  "remoteEnv": { "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}" },

  // マウント先の親ディレクトリは root で作られるので、vscode に戻す
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude /home/vscode/.gradle /home/vscode/.gradle/caches && curl -fsSL https://claude.ai/install.sh | bash",

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  },
  "remoteUser": "vscode",

  // VS Code のウィンドウを閉じてもコンテナを止めない（中の tmux や claude を動かし続ける）
  "shutdownAction": "none"
}
