        <mxCell id="localText" value="・接続キット（remote.cmd、接続先、&lt;br&gt;&amp;nbsp; 導入説明書、.devcontainer）&lt;br&gt;&amp;nbsp; start / stop / status / tmux / shell / ssh&lt;br&gt;・VS Code（Remote-SSH）&lt;br&gt;&amp;nbsp; ssh remote-claude-&amp;lt;名前&amp;gt;&lt;br&gt;・AWS CLI v2 + Session Manager Plugin&lt;br&gt;・認証は自分の IAM ユーザー" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="215" height="170" as="geometry" />
        </mxCell>
        <mxCell id="eAdminLocal" value="接続キット（zip）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="admin" target="local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;メモ&lt;/b&gt;&lt;br&gt;・インバウンドは全閉（SSM 経由のみ）&lt;br&gt;・context egress=nat（既定）の構成&lt;br&gt;&amp;nbsp; public：パブリック IP、エンドポイントなし&lt;br&gt;&amp;nbsp; isolated：NAT なし（閉域）&lt;br&gt;・IMDSv2 必須、ホップ数 2&lt;br&gt;&amp;nbsp; （devcontainer からロールを使う）&lt;br&gt;・スタック&lt;br&gt;&amp;nbsp; RemoteClaudeBaseStack：VPC、NAT、&lt;br&gt;&amp;nbsp; エンドポイント、ロール、ポリシー（共有）&lt;br&gt;&amp;nbsp; RemoteClaude-&amp;lt;名前&amp;gt;：EC2（1人1つ）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=1;fillColor=#FFF9E5;strokeColor=#D6B656;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="230" height="200" as="geometry" />
        </mxCell>
        <!-- ===== インターネット ===== -->
        <mxCell id="internet" value="Internet&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;GitHub / npm / mcr.microsoft.com・ghcr.io&lt;br&gt;（devcontainer のイメージ、Claude Code、Gradle）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontStyle=1;" vertex="1" parent="1">
