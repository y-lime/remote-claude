        <!-- ===== 手元 ===== -->
        <mxCell id="admin" value="&lt;b&gt;管理者の PC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;cd cdk; npm run deploy&lt;br&gt;（cdk deploy --all → 接続キット作成）&lt;br&gt;→ kits/remote-claude-&amp;lt;名前&amp;gt;.zip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
